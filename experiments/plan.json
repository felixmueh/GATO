      "command": ["{python}", "{runner}/adapters/heatmap.py", "--case", "{case}", "--output", "{output}"],
      "repeats": 3,
      "cases": [
        {"id": "N16-B1", "parameters": {"N": 16, "batch": 1, "horizon_seconds": 0.504, "sqp_iterations": 5, "wall_seconds": 2, "seed": 20261009}},
        {"id": "N32-B1", "parameters": {"N": 32, "batch": 1, "horizon_seconds": 0.504, "sqp_iterations": 5, "wall_seconds": 2, "seed": 20261009}}
      ]
    }
