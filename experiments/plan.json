      "source_commit": "7187cf8842d0cc33184ade757c15e69c60b69bca",
      "machines": ["gtx1070", "rtx5060", "jetson"],
      "build": {
        "commands": [
          ["cmake", "-S", "{source}/examples/solve_time_heatmap", "-B", "{build}", "-DPLANT=tiago_right", "-DKNOTS=16;32", "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_CUDA_ARCHITECTURES={cuda_arch}", "-DPython3_EXECUTABLE={python}"],
          ["cmake", "--build", "{build}", "--parallel", "2"]
