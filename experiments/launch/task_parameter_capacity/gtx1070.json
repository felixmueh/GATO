            "-DPLANT=tiago_right",
            "-DCMAKE_BUILD_TYPE=Release",
            "-DCMAKE_CUDA_ARCHITECTURES={cuda_arch}-real",
            "-DPython3_EXECUTABLE={python}"
          ],
          [
            "cmake",
            "--build",
            "{build}",
            "--target",
            "resources_N256",
            "--parallel",
            "2"
          ]
        ],
        "artifacts": [
          "resources_N256"
        ]
      },
      "command": [
        "{python}",
        "{runner}/adapters/task_parameter_capacity.py",
        "--build",
        "{build}",
        "--case",
        "{case}",
        "--output",
        "{output}"
      ],
      "cases": [
        {
          "id": "configured-resource-limit",
          "parameters": {
            "N": 256
          }
        }
      ],
      "timeout_seconds": 60,
      "scope": "No solver/task/ROS execution. Existing probe queries attributes and attempts only an invalid launch when configuration cannot fit."
